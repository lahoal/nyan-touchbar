// BTT-Plugin-Name: Nyan Cat
// BTT-Plugin-Identifier: io.github.lahoal.nyancat
// BTT-Plugin-Type: TouchBar
// BTT-Plugin-Icon: sparkles
//
// Nyan Cat animado para la Touch Bar, con accesorios según lo que estés haciendo.
// ARCHIVO GENERADO por generar.py (editar NyanCat.swift.in, no este).
import Cocoa
import CoreAudio
import CoreMediaIO
import IOKit
import IOKit.ps
import Network

// Tiras de 12 cuadros (138x60 px c/u), PNG en base64.
private let sprites: [String: String] = [
/*SPRITES*/
]

// Copia de apps.json embebida; se usa si no existe ~/Library/Application Support/NyanCat/apps.json.
private let appsPorDefecto = #"""
/*APPS*/
"""#

private struct ConfigApps: Decodable {
    var apps: [String: [String]] = [:]
    var navegadores: [String] = []
    var titulos: [String: [String]] = [:]

    func coincide(_ id: String, _ patrones: [String]) -> Bool {
        patrones.contains { $0.hasSuffix("*") ? id.hasPrefix($0.dropLast()) : $0 == id }
    }
}

/// Por zona del dibujo, la primera regla cuyo estado esté activo gana; así dos accesorios nunca se pisan.
private let zonas: [[(estados: [String], capa: String)]] = [
    [(["terminal"], "base_matrix"), (["bateria_baja"], "base_destenida"), ([], "base")],
    [(["microfono"], "audifonos"), (["halloween"], "sombrero_bruja"), (["navidad"], "gorro_navidad"),
     (["fiestas_patrias"], "chupalla"), (["ano_nuevo"], "gorro_fiesta"), (["diseno"], "boina"),
     (["escritura"], "lapiz"), (["noche"], "gorro_noche")],                                     // cabeza
    [(["terminal"], "lentes_hacker"), (["noche", "inactivo"], "dormido"), (["bateria_baja"], "cansado")],  // ojos
    [(["videollamada"], "corbata")],                                                            // cuello
    [(["juegos"], "control"), (["video"], "palomitas"), (["manana"], "cafe")],                  // frente
    [(["noche", "inactivo"], "zzz"), (["chat"], "globo")],                                      // arriba a la izquierda
    [(["musica"], "notas")], [(["cargando"], "rayo")], [(["sin_red"], "sin_red")],
    [(["cpu"], "sudor")], [(["caliente"], "derretido")],
]

/// Moods que el triple toque oculta hasta su próxima ocurrencia (ver `ocurrencia`).
private let descartables: Set<String> = ["manana", "video", "chat", "halloween", "navidad", "ano_nuevo", "fiestas_patrias"]

class NyanCat: NSObject, BTTPluginInterface {
    weak var delegate: (any BTTTouchBarPluginDelegate)?

    private var capas: [String: CALayer] = [:]
    private var animadas: [CALayer] = []  // capas cuyos 12 cuadros no son todos iguales
    private let gatoCapa = CALayer(), panelCapa = CALayer()  // el gato puede cambiar de velocidad sin arrastrar al panel
    private var activas: [String] = ["base"]
    private var intervalo = 0.09
    private var timerEstado: Timer?
    private var finales: [String: DispatchWorkItem] = [:]
    private var avisos: [NSObjectProtocol] = []
    private var pantallaDormida = false
    // Lo que cambia poco se lee cada tanto o llega por aviso: cada consulta a BTT o a macOS es una llamada a otro proceso.
    private var vuelta = 0
    private var forzadoLeido = ""
    private var appReproductor = ""
    private var frente = (id: "", pid: pid_t(0))
    private var bateriaActual: (Int?, Bool) = (nil, false)
    private var fuenteBateria: CFRunLoopSource?
    private var cpuPrevio: (uso: UInt64, total: UInt64)?
    private var cpuAltaSeg = 0
    private var config = ConfigApps()
    private var configFecha: Date?
    private let rutaConfig = FileManager.default.homeDirectoryForCurrentUser
        .appendingPathComponent("Library/Application Support/NyanCat/apps.json")
    private let red = NWPathMonitor()
    private var hayRed = true
    private var estado = Set<String>()
    private var descartados: [String: String] = [:]  // mood → ocurrencia descartada
    private var descartesFecha: Date?
    private var rutaDescartes = FileManager.default.homeDirectoryForCurrentUser
        .appendingPathComponent("Library/Application Support/NyanCat/descartados.json")
    private var toques: [Date] = []
    private var transitorios: [String: Int] = [:]  // capa → cuadros que dura (destello, ráfaga, toque, deslizar)
    private var capasGato: [String] = []
    private var esquema = "base"  // colores del panel según la base del gato: base, matrix o destenida
    private var reproductor = false
    private var sonando = false
    private var sonandoOptimista: (valor: Bool, hasta: Date)?
    private var paso: Float = 1  // velocidad del gato: 2 tras «siguiente», -1 (rebobina) tras «anterior»
    private lazy var vibrador = Vibrador()

    private lazy var tecla: (Int) -> Void = { [weak self] in self?.teclaMedia($0) }

    // Medidas en pt: gato de 69 y panel de 66, con un botón de 60 que parte 3 pt adentro.
    private let anchoGato: CGFloat = 69, anchoPanel: CGFloat = 66

    private lazy var viewController: NSViewController = {
        let vc = NSViewController()
        let v = VistaToques(frame: NSRect(x: 0, y: 0, width: anchoGato + anchoPanel, height: 30))
        v.wantsLayer = true
        v.translatesAutoresizingMaskIntoConstraints = false
        v.widthAnchor.constraint(equalToConstant: anchoGato + anchoPanel).isActive = true
        v.heightAnchor.constraint(equalToConstant: 30).isActive = true
        vc.view = v
        v.alSoltar = { [weak self] x, dx in self?.tocado(x, dx) }
        v.alCambiarVentana = { [weak self] _ in self?.revisarPausa() }
        gatoCapa.frame = NSRect(x: 0, y: 0, width: anchoGato, height: 30)
        panelCapa.frame = NSRect(x: anchoGato, y: 0, width: anchoPanel, height: 30)
        v.layer?.addSublayer(gatoCapa); v.layer?.addSublayer(panelCapa)
        for (nombre, b64) in sprites {
            guard let data = Data(base64Encoded: b64), let src = CGImageSourceCreateWithData(data as CFData, nil),
                  let png = CGImageSourceCreateImageAtIndex(src, 0, nil) else { continue }
            let (tira, fija) = decodificar(png)
            let capa = CALayer()
            let enPanel = ["cielo_", "panel_", "toque_", "desliza_"].contains { nombre.hasPrefix($0) }
            let padre = nombre == "rafaga" ? v.layer! : enPanel ? panelCapa : gatoCapa
            capa.frame = padre.bounds
            capa.contents = tira  // la tira completa, una sola vez; los cuadros se eligen con contentsRect
            capa.contentsRect = recorte(0)
            capa.contentsGravity = .resize
            capa.magnificationFilter = .nearest
            capa.isHidden = true
            capa.zPosition = nombre == "rafaga" ? 3 : nombre.hasPrefix("base") || nombre.hasPrefix("cielo_") ? 0
                : nombre.hasPrefix("panel_") ? 1 : 2
            padre.addSublayer(capa)
            capas[nombre] = capa
            if !fija && !esTransitoria(nombre) { animadas.append(capa) }
        }
        red.pathUpdateHandler = { [weak self] p in DispatchQueue.main.async { self?.hayRed = p.status == .satisfied } }
        red.start(queue: .global(qos: .utility))
        let ws = NSWorkspace.shared.notificationCenter
        if let app = NSWorkspace.shared.frontmostApplication { frente = (app.bundleIdentifier ?? "", app.processIdentifier) }
        avisos.append(ws.addObserver(forName: NSWorkspace.didActivateApplicationNotification, object: nil, queue: .main) { [weak self] n in
            guard let self, let app = n.userInfo?[NSWorkspace.applicationUserInfoKey] as? NSRunningApplication else { return }
            self.frente = (app.bundleIdentifier ?? "", app.processIdentifier)
            if self.timerEstado != nil { self.actualizarEstado() }
        })
        bateriaActual = bateria()
        let yo = Unmanaged.passUnretained(self).toOpaque()
        fuenteBateria = IOPSNotificationCreateRunLoopSource({ ctx in
            guard let ctx else { return }
            let gato = Unmanaged<NyanCat>.fromOpaque(ctx).takeUnretainedValue()
            gato.bateriaActual = gato.bateria()
        }, yo)?.takeRetainedValue()
        if let fuenteBateria { CFRunLoopAddSource(CFRunLoopGetMain(), fuenteBateria, .commonModes) }
        for (nombre, dormida) in [(NSWorkspace.screensDidSleepNotification, true), (NSWorkspace.screensDidWakeNotification, false),
                                  (NSWorkspace.sessionDidResignActiveNotification, true), (NSWorkspace.sessionDidBecomeActiveNotification, false)] {
            avisos.append(ws.addObserver(forName: nombre, object: nil, queue: .main) { [weak self] _ in
                self?.pantallaDormida = dormida; self?.revisarPausa()
            })
        }
        actualizarEstado()
        animarTodas()
        return vc
    }()

    deinit {
        timerEstado?.invalidate(); red.cancel()
        if let fuenteBateria { CFRunLoopRemoveSource(CFRunLoopGetMain(), fuenteBateria, .commonModes) }
        avisos.forEach { NSWorkspace.shared.notificationCenter.removeObserver($0) }
    }

    static func configurationFormItems() -> BTTPluginFormItem? { nil }

    func didReceiveNewConfigurationValues(_ configurationValues: [AnyHashable: Any]) {}

    func touchBarViewController() -> NSViewController? { viewController }

    // MARK: - Animación
    // Core Animation cambia los cuadros por su cuenta (sin timer en el plugin): a la Touch Bar solo le llega
    // un recorte distinto de la misma imagen, en vez de una imagen nueva por capa en cada cuadro.

    private func recorte(_ cuadro: Int) -> CGRect { CGRect(x: CGFloat(cuadro) / 12, y: 0, width: 1.0 / 12, height: 1) }

    private func esTransitoria(_ nombre: String) -> Bool {
        nombre == "rafaga" || nombre == "destello" || nombre.hasPrefix("toque_") || nombre.hasPrefix("desliza_")
    }

    /// Animación por pasos de los cuadros `desde`…11. Todas las capas que se repiten parten en el mismo instante
    /// (beginTime 1 en su tiempo local), así los accesorios se mueven al compás del cuerpo.
    private func cuadros(desde: Int, inicio: CFTimeInterval, repetir: Bool) -> CAKeyframeAnimation {
        let n = 12 - desde
        let a = CAKeyframeAnimation(keyPath: "contentsRect")
        a.values = (desde..<12).map { NSValue(rect: recorte($0)) }
        a.keyTimes = (0...n).map { NSNumber(value: Double($0) / Double(n)) }
        a.calculationMode = .discrete
        a.duration = Double(n) * intervalo
        a.beginTime = inicio
        a.repeatCount = repetir ? .infinity : 1
        a.fillMode = .forwards
        a.isRemovedOnCompletion = false
        return a
    }

    private func animarTodas() {
        for capa in animadas { capa.add(cuadros(desde: 0, inicio: 1, repetir: true), forKey: "cuadros") }
    }

    /// Muestra una capa transitoria con los últimos n cuadros de su tira y la esconde al terminar.
    private func unaVez(_ nombre: String, _ n: Int) {
        guard let capa = capas[nombre] else { return }
        transitorios[nombre] = n
        capa.add(cuadros(desde: 12 - n, inicio: capa.convertTime(CACurrentMediaTime(), from: nil), repetir: false), forKey: "unaVez")
        finales[nombre]?.cancel()
        let fin = DispatchWorkItem { [weak self] in
            self?.transitorios[nombre] = nil
            self?.aplicarVisibilidad()
            capa.removeAnimation(forKey: "unaVez")
        }
        finales[nombre] = fin
        DispatchQueue.main.asyncAfter(deadline: .now() + Double(n) * intervalo, execute: fin)
        aplicarVisibilidad()
    }

    /// Solo toca las capas que cambian de visible a oculta o al revés.
    private func aplicarVisibilidad() {
        let deseadas = Set(activas).union(transitorios.keys)
        CATransaction.begin(); CATransaction.setDisableActions(true)
        for (nombre, capa) in capas where capa.isHidden == deseadas.contains(nombre) { capa.isHidden.toggle() }
        CATransaction.commit()
    }

    /// Cambia la velocidad del gato sin saltos durante `cuadros` cuadros y después la devuelve a 1.
    private func velocidadGato(_ v: Float, cuadros: Int) {
        func fijar(_ v: Float) {
            let ahora = CACurrentMediaTime()
            gatoCapa.timeOffset = gatoCapa.convertTime(ahora, from: nil)
            gatoCapa.beginTime = ahora
            gatoCapa.speed = v
            paso = v
        }
        fijar(v)
        finales["velocidad"]?.cancel()
        let fin = DispatchWorkItem { fijar(1) }
        finales["velocidad"] = fin
        DispatchQueue.main.asyncAfter(deadline: .now() + Double(cuadros) * intervalo, execute: fin)
    }

    /// Revisa el estado una vez por segundo solo mientras el widget está en pantalla y la pantalla despierta.
    /// BTT crea una instancia por grupo de la Touch Bar; las de los grupos que no se ven quedan quietas.
    private func revisarPausa() {
        let visible = viewController.view.window != nil && !pantallaDormida
        if visible && timerEstado == nil {
            actualizarEstado()
            timerEstado = Timer(timeInterval: 1, repeats: true) { [weak self] _ in self?.actualizarEstado() }
            RunLoop.main.add(timerEstado!, forMode: .common)
        } else if !visible {
            timerEstado?.invalidate()
            timerEstado = nil
        }
    }

    /// x: dónde empezó el toque; dx: cuánto se movió el dedo hasta soltar. Sobre el botón, más de 12 pt es deslizar.
    private func tocado(_ x: CGFloat, _ dx: CGFloat) {
        if x >= anchoGato && reproductor { usarBoton(abs(dx) < 12 ? 0 : dx > 0 ? 1 : -1) }
        else if abs(dx) < 12 { tocarGato() }
    }

    /// 0 = play/pausa, 1 = siguiente, -1 = anterior: tecla de media del sistema, animación del botón y reacción del gato.
    private func usarBoton(_ gesto: Int) {
        vibrador.pulso(fuerte: false)
        switch gesto {
        case 0:
            tecla(16)  // NX_KEYTYPE_PLAY
            unaVez((sonando ? "toque_a_play_" : "toque_a_pausa_") + esquema, 8)
            sonandoOptimista = (!sonando, Date().addingTimeInterval(2.5))  // BTT tarda ~1 s en enterarse
        case 1:
            tecla(17)  // NX_KEYTYPE_NEXT
            unaVez("desliza_siguiente_" + esquema, 8)
            velocidadGato(2, cuadros: 8)
        default:
            tecla(18)  // NX_KEYTYPE_PREVIOUS
            unaVez("desliza_anterior_" + esquema, 8)
            velocidadGato(-1, cuadros: 8)
        }
        actualizarEstado()
    }

    /// Lo mismo que las teclas F7–F9: macOS se lo manda a lo que esté sonando (Spotify, Música, el navegador…).
    private func teclaMedia(_ tecla: Int) {
        for abajo in [true, false] {
            let flags = NSEvent.ModifierFlags(rawValue: abajo ? 0xa00 : 0xb00)
            NSEvent.otherEvent(with: .systemDefined, location: .zero, modifierFlags: flags, timestamp: 0, windowNumber: 0,
                               context: nil, subtype: 8, data1: (tecla << 16) | ((abajo ? 0xa : 0xb) << 8), data2: -1)?
                .cgEvent?.post(tap: .cghidEventTap)
        }
    }

    /// Cada toque vibra suave; el tercero seguido oculta los moods descartables a la vista, o los devuelve si no hay.
    private func tocarGato() {
        let ahora = Date()
        toques = toques.filter { ahora.timeIntervalSince($0) < 0.8 } + [ahora]
        guard toques.count >= 3 else { vibrador.pulso(fuerte: false); return }
        toques = []
        leerDescartes()
        let visibles = estado.intersection(descartables).filter { descartados[$0] != ocurrencia($0, ahora) }
        if !visibles.isEmpty { for m in visibles { descartados[m] = ocurrencia(m, ahora) } }
        else if !descartados.isEmpty { descartados = [:] }
        else { vibrador.pulso(fuerte: false); return }
        guardarDescartes()
        vibrador.pulso(fuerte: true)
        unaVez("destello", 12)
        actualizarEstado()
    }

    // MARK: - Estado

    private func actualizarEstado() {
        var e = Set<String>()
        if vuelta % 5 == 0 {  // cada 5 s: variable de prueba, archivos de configuración y descartes
            forzadoLeido = (delegate?.getVariable("nyan_forzar") as? String ?? "").trimmingCharacters(in: .whitespaces)
            recargarConfig()
            leerDescartes()
        }
        vuelta += 1
        let forzado = forzadoLeido
        if !forzado.isEmpty {
            e = Set(forzado.split(separator: ",").map { $0.trimmingCharacters(in: .whitespaces) })
            (reproductor, sonando) = (e.contains("musica") || e.contains("reproductor"), e.contains("musica"))
        } else {
            let v = delegate?.getVariable("BTTCurrentlyPlaying").map { "\($0)" }
            sonando = v == "1" || v == "1.0"
            if let o = sonandoOptimista, Date() < o.hasta { sonando = o.valor }
            if !sonando && vuelta % 3 == 1 {  // el reproductor en pausa aparece o desaparece rara vez
                appReproductor = delegate?.getVariable("BTTCurrentlyPlayingApp") as? String ?? ""
            }
            reproductor = !appReproductor.isEmpty || sonando
            if sonando { e.insert("musica") }
            e.formUnion(estadosDeApp())
            if microfonoEnUso() { e.insert("microfono") }
            if camaraEnUso() { e.insert("videollamada") }
            let (pct, cargando) = bateriaActual
            if cargando { e.insert("cargando") } else if let pct, pct <= 20 { e.insert("bateria_baja") }
            if cpuAlta() { e.insert("cpu") }
            if !hayRed { e.insert("sin_red") }
            if ProcessInfo.processInfo.thermalState.rawValue >= ProcessInfo.ThermalState.serious.rawValue { e.insert("caliente") }
            let inputCualquiera = CGEventType(rawValue: ~0)!
            if CGEventSource.secondsSinceLastEventType(.combinedSessionState, eventType: inputCualquiera) > 300 { e.insert("inactivo") }
            e.formUnion(estadosDeCalendario(Date()))
        }
        let ahora = Date()
        // Se olvidan los descartes de ocurrencias pasadas; los de apps, solo al dejar la app (no al forzar estados).
        let vigentes = descartados.filter { m, o in
            o.isEmpty ? (e.contains(m) || !forzado.isEmpty) : o == ocurrencia(m, ahora)
        }
        if vigentes != descartados { descartados = vigentes; guardarDescartes() }
        estado = e
        e.subtract(descartados.keys)
        let gato = zonas.compactMap { reglas in reglas.first { $0.estados.isEmpty || !e.isDisjoint(with: $0.estados) }?.capa }
        let rafaga = !capasGato.isEmpty && gato != capasGato && transitorios["destello"] == nil
        capasGato = gato
        esquema = gato.first.map { $0 == "base" ? "base" : String($0.dropFirst(5)) } ?? "base"  // base_matrix → matrix
        activas = gato + ["cielo_" + esquema, (reproductor ? (sonando ? "panel_pausa_" : "panel_play_") : "panel_apagado_") + esquema]
        let nuevo = e.contains("cpu") ? 0.045 : e.contains("inactivo") ? 0.3 : 0.09
        if nuevo != intervalo { intervalo = nuevo; animarTodas() }
        if rafaga { unaVez("rafaga", 12) } else { aplicarVisibilidad() }
    }

    /// Qué cuenta como «la misma vez» de un mood: el día para el café, el año para las fechas especiales
    /// y, para los moods de apps (""), mientras la app siga al frente.
    private func ocurrencia(_ mood: String, _ fecha: Date) -> String {
        let c = Calendar.current.dateComponents([.year, .month, .day], from: fecha)
        let (a, m, d) = (c.year ?? 0, c.month ?? 0, c.day ?? 0)
        switch mood {
        case "manana": return "\(a)-\(m)-\(d)"
        case "ano_nuevo": return "\(m == 1 ? a - 1 : a)"  // 31 dic y 1 ene son la misma fiesta
        case "halloween", "navidad", "fiestas_patrias": return "\(a)"
        default: return ""
        }
    }

    /// Los descartes viven en un archivo para que los compartan todas las instancias del widget
    /// (BTT crea una por grupo, p. ej. Global y "Music Playing") y sobrevivan a un reinicio de BTT.
    private func leerDescartes() {
        let fecha = (try? FileManager.default.attributesOfItem(atPath: rutaDescartes.path))?[.modificationDate] as? Date
        guard fecha != descartesFecha else { return }
        descartesFecha = fecha
        descartados = (try? JSONDecoder().decode([String: String].self, from: Data(contentsOf: rutaDescartes))) ?? [:]
    }

    private func guardarDescartes() {
        try? FileManager.default.createDirectory(at: rutaDescartes.deletingLastPathComponent(), withIntermediateDirectories: true)
        try? JSONEncoder().encode(descartados).write(to: rutaDescartes, options: .atomic)
        descartesFecha = (try? FileManager.default.attributesOfItem(atPath: rutaDescartes.path))?[.modificationDate] as? Date
    }

    private func estadosDeCalendario(_ fecha: Date) -> Set<String> {
        let c = Calendar.current.dateComponents([.month, .day, .hour], from: fecha)
        let (m, d, h) = (c.month ?? 0, c.day ?? 0, c.hour ?? 12)
        var e = Set<String>()
        if h < 6 { e.insert("noche") } else if h >= 7 && h < 10 { e.insert("manana") }
        if m == 12 && (d == 24 || d == 25) { e.insert("navidad") }
        if (m == 12 && d == 31) || (m == 1 && d == 1) { e.insert("ano_nuevo") }
        if m == 9 && (d == 18 || d == 19) { e.insert("fiestas_patrias") }
        if m == 10 && d == 31 { e.insert("halloween") }
        return e
    }

    /// Moods por app al frente o, en navegadores, por el título de la ventana activa.
    private func estadosDeApp() -> Set<String> {
        let (id, pid) = frente  // llega por aviso al cambiar de app
        guard !id.isEmpty else { return [] }
        var e = Set(config.apps.filter { config.coincide(id, $0.value) }.keys)
        if config.coincide(id, config.navegadores) {
            let titulo = tituloVentana(pid).lowercased()
            if !titulo.isEmpty {
                e.formUnion(config.titulos.filter { $0.value.contains { titulo.contains($0.lowercased()) } }.keys)
            }
        }
        return e
    }

    private func recargarConfig() {
        let fecha = (try? FileManager.default.attributesOfItem(atPath: rutaConfig.path))?[.modificationDate] as? Date
        if fecha == configFecha && (fecha != nil || !config.apps.isEmpty) { return }
        configFecha = fecha
        let datos = fecha != nil ? (try? Data(contentsOf: rutaConfig)) : nil
        if let datos, let c = try? JSONDecoder().decode(ConfigApps.self, from: datos) { config = c; return }
        if let c = try? JSONDecoder().decode(ConfigApps.self, from: Data(appsPorDefecto.utf8)) { config = c }  // archivo ausente o inválido
    }

    /// Título de la ventana activa vía Accesibilidad (BTT ya tiene ese permiso); vacío si no se puede leer.
    private func tituloVentana(_ pid: pid_t) -> String {
        let ax = AXUIElementCreateApplication(pid)
        AXUIElementSetMessagingTimeout(ax, 0.2)
        var ventana: CFTypeRef?
        guard AXUIElementCopyAttributeValue(ax, kAXFocusedWindowAttribute as CFString, &ventana) == .success,
              let ventana, CFGetTypeID(ventana) == AXUIElementGetTypeID() else { return "" }
        var titulo: CFTypeRef?
        AXUIElementCopyAttributeValue(ventana as! AXUIElement, kAXTitleAttribute as CFString, &titulo)
        return titulo as? String ?? ""
    }

    private func microfonoEnUso() -> Bool {
        var dev = AudioDeviceID(0)
        var size = UInt32(MemoryLayout<AudioDeviceID>.size)
        var dir = AudioObjectPropertyAddress(mSelector: kAudioHardwarePropertyDefaultInputDevice,
                                             mScope: kAudioObjectPropertyScopeGlobal, mElement: kAudioObjectPropertyElementMain)
        guard AudioObjectGetPropertyData(AudioObjectID(kAudioObjectSystemObject), &dir, 0, nil, &size, &dev) == noErr, dev != 0 else { return false }
        var corriendo = UInt32(0)
        size = UInt32(MemoryLayout<UInt32>.size)
        dir.mSelector = kAudioDevicePropertyDeviceIsRunningSomewhere
        guard AudioObjectGetPropertyData(dev, &dir, 0, nil, &size, &corriendo) == noErr else { return false }
        return corriendo != 0
    }

    /// Alguna cámara (incluidas las virtuales) está siendo usada por alguna app.
    private func camaraEnUso() -> Bool {
        var dir = CMIOObjectPropertyAddress(mSelector: CMIOObjectPropertySelector(kCMIOHardwarePropertyDevices),
                                            mScope: CMIOObjectPropertyScope(kCMIOObjectPropertyScopeGlobal),
                                            mElement: CMIOObjectPropertyElement(kCMIOObjectPropertyElementMain))
        let sistema = CMIOObjectID(kCMIOObjectSystemObject)
        var size: UInt32 = 0, usado: UInt32 = 0
        guard CMIOObjectGetPropertyDataSize(sistema, &dir, 0, nil, &size) == noErr, size > 0 else { return false }
        var devs = [CMIOObjectID](repeating: 0, count: Int(size) / MemoryLayout<CMIOObjectID>.size)
        guard CMIOObjectGetPropertyData(sistema, &dir, 0, nil, size, &usado, &devs) == noErr else { return false }
        dir.mSelector = CMIOObjectPropertySelector(kCMIODevicePropertyDeviceIsRunningSomewhere)
        return devs.contains { dev in
            var on: UInt32 = 0
            return CMIOObjectGetPropertyData(dev, &dir, 0, nil, UInt32(MemoryLayout<UInt32>.size), &usado, &on) == noErr && on != 0
        }
    }

    private func bateria() -> (Int?, Bool) {
        guard let info = IOPSCopyPowerSourcesInfo()?.takeRetainedValue(),
              let lista = IOPSCopyPowerSourcesList(info)?.takeRetainedValue() as? [CFTypeRef] else { return (nil, false) }
        for ps in lista {
            guard let d = IOPSGetPowerSourceDescription(info, ps)?.takeUnretainedValue() as? [String: Any],
                  d[kIOPSTypeKey] as? String == kIOPSInternalBatteryType else { continue }
            let cur = d[kIOPSCurrentCapacityKey] as? Int ?? 0, max = d[kIOPSMaxCapacityKey] as? Int ?? 100
            return (max > 0 ? cur * 100 / max : nil, d[kIOPSIsChargingKey] as? Bool ?? false)
        }
        return (nil, false)
    }

    /// CPU total sobre 70 % durante 3 s seguidos.
    private func cpuAlta() -> Bool {
        var info = host_cpu_load_info()
        var n = mach_msg_type_number_t(MemoryLayout<host_cpu_load_info>.size / MemoryLayout<integer_t>.size)
        let r = withUnsafeMutablePointer(to: &info) {
            $0.withMemoryRebound(to: integer_t.self, capacity: Int(n)) { host_statistics(mach_host_self(), HOST_CPU_LOAD_INFO, $0, &n) }
        }
        guard r == KERN_SUCCESS else { return false }
        let t = info.cpu_ticks
        let uso = UInt64(t.0) + UInt64(t.1) + UInt64(t.3), total = uso + UInt64(t.2)
        defer { cpuPrevio = (uso, total) }
        guard let p = cpuPrevio, total > p.total else { return false }
        let pct = Double(uso - p.uso) / Double(total - p.total)
        cpuAltaSeg = pct > 0.7 ? cpuAltaSeg + 1 : 0
        return cpuAltaSeg >= 3
    }
}

/// Vibración del trackpad con MultitouchSupport (API privada, la misma que usa HapticKey): la Touch Bar no
/// tiene motor propio y la API pública solo vibra con un dedo sobre el trackpad. Si la API cambia, no vibra.
private final class Vibrador {
    private typealias Crear = @convention(c) (UInt64) -> Unmanaged<CFTypeRef>?
    private typealias Abrir = @convention(c) (CFTypeRef) -> Int32
    private typealias Actuar = @convention(c) (CFTypeRef, Int32, UInt32, Float, Float) -> Int32
    private var actuador: CFTypeRef?
    private var actuar: Actuar?

    init() {
        guard let h = dlopen("/System/Library/PrivateFrameworks/MultitouchSupport.framework/MultitouchSupport", RTLD_NOW),
              let c = dlsym(h, "MTActuatorCreateFromDeviceID"), let o = dlsym(h, "MTActuatorOpen"),
              let a = dlsym(h, "MTActuatorActuate") else { return }
        let crear = unsafeBitCast(c, to: Crear.self), abrir = unsafeBitCast(o, to: Abrir.self)
        var it: io_iterator_t = 0
        guard IOServiceGetMatchingServices(kIOMainPortDefault, IOServiceMatching("AppleMultitouchDevice"), &it) == KERN_SUCCESS else { return }
        defer { IOObjectRelease(it) }
        while case let s = IOIteratorNext(it), s != 0 {  // el primer dispositivo con actuador (el trackpad)
            defer { IOObjectRelease(s) }
            guard let id = (IORegistryEntryCreateCFProperty(s, "Multitouch ID" as CFString, nil, 0)?.takeRetainedValue() as? NSNumber)?.uint64Value,
                  let act = crear(id)?.takeRetainedValue(), abrir(act) == 0 else { continue }
            actuador = act
            actuar = unsafeBitCast(a, to: Actuar.self)
            return
        }
    }

    /// 3 = clic suave, 6 = clic fuerte (tipos de actuación del trackpad).
    func pulso(fuerte: Bool) {
        if let actuador, let actuar { _ = actuar(actuador, fuerte ? 6 : 3, 0, 0, 0) }
    }
}

/// Descomprime la tira PNG una sola vez (para que no se vuelva a decodificar al mostrarla) y dice si sus
/// 12 cuadros son idénticos: esas capas no necesitan animación.
private func decodificar(_ png: CGImage) -> (CGImage, fija: Bool) {
    let (w, h) = (png.width, png.height)
    guard let ctx = CGContext(data: nil, width: w, height: h, bitsPerComponent: 8, bytesPerRow: w * 4,
                              space: CGColorSpaceCreateDeviceRGB(), bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue),
          let datos = ctx.data else { return (png, false) }
    ctx.draw(png, in: CGRect(x: 0, y: 0, width: w, height: h))
    let ancho = w / 12 * 4, bytes = datos.assumingMemoryBound(to: UInt8.self)
    let fija = (0..<h).allSatisfy { y in
        let fila = bytes + y * w * 4
        return (1..<12).allSatisfy { memcmp(fila, fila + $0 * ancho, ancho) == 0 }
    }
    return (ctx.makeImage() ?? png, fija)
}

/// Vista del widget: avisa dónde empezó cada toque, cuánto se deslizó el dedo al soltarlo y si entra o sale de pantalla.
private final class VistaToques: NSView {
    var alSoltar: ((CGFloat, CGFloat) -> Void)?
    var alCambiarVentana: ((Bool) -> Void)?

    override func viewDidMoveToWindow() { alCambiarVentana?(window != nil) }
    private var inicio: [ObjectIdentifier: CGFloat] = [:]

    override init(frame: NSRect) { super.init(frame: frame); allowedTouchTypes = [.direct] }
    required init?(coder: NSCoder) { nil }

    override func touchesBegan(with event: NSEvent) {
        for t in event.touches(matching: .began, in: self) { inicio[ObjectIdentifier(t.identity)] = t.location(in: self).x }
    }

    override func touchesEnded(with event: NSEvent) {
        for t in event.touches(matching: .ended, in: self) {
            guard let x0 = inicio.removeValue(forKey: ObjectIdentifier(t.identity)) else { continue }
            alSoltar?(x0, t.location(in: self).x - x0)
        }
    }

    override func touchesCancelled(with event: NSEvent) { inicio.removeAll() }
}
